# Copy to .env for local development. Never commit real secrets.

# Django
DJANGO_SECRET_KEY=change-me-local-only
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (compose.yaml sets POSTGRES_HOST=db inside the container)
POSTGRES_DB=menuamano
POSTGRES_USER=menuamano
POSTGRES_PASSWORD=menuamano
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Email: "console" prints emails in the web logs (local default); "mailgun" sends them.
EMAIL_PROVIDER=console
DEFAULT_FROM_EMAIL=menuamano <no-reply@localhost>
MAILGUN_API_KEY=
MAILGUN_SENDER_DOMAIN=
# EU region: https://api.eu.mailgun.net/v3
MAILGUN_API_URL=https://api.mailgun.net/v3
MAILGUN_WEBHOOK_SIGNING_KEY=
# Server error reports, e.g. "Ana <ana@example.com>"
DJANGO_ADMINS=

# AI provider: "demo" (deterministic, no key, clearly labelled) or "openai".
AI_PROVIDER=demo
# Only read by the backend. Leave empty to keep the assistant in demo/disabled mode.
OPENAI_API_KEY=
# Any model that supports Structured Outputs in the Responses API.
OPENAI_MODEL=
OPENAI_TIMEOUT_SECONDS=45
OPENAI_MAX_RETRIES=2
