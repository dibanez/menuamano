# Copy to .env for local development. Never commit real secrets.

# Django
DJANGO_SECRET_KEY=change-me-local-only
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (compose.yaml sets POSTGRES_HOST=db inside the container)
POSTGRES_DB=menuamano
POSTGRES_USER=menuamano
POSTGRES_PASSWORD=menuamano
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# AI provider: "demo" (deterministic, no key, clearly labelled) or "openai".
AI_PROVIDER=demo
# Only read by the backend. Leave empty to keep the assistant in demo/disabled mode.
OPENAI_API_KEY=
# Any model that supports Structured Outputs in the Responses API.
OPENAI_MODEL=
OPENAI_TIMEOUT_SECONDS=45
OPENAI_MAX_RETRIES=2
