# menuamano environment variables. Never commit real secrets.
#
# Local development: copy this file to .env; compose.yaml loads it into the web container.
# Production (Dokploy): define the variables in the Environment tab; compose.prod.yaml reads
# them through ${VAR}. Lines marked [prod: required] must be set there or the deployment fails.
# Lines starting with "#" below are production-only examples, ignored locally.

# --- Django ------------------------------------------------------------------------------------
# [prod: required] Long random string, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-local-only
# Local only (production always runs with DEBUG=False).
DJANGO_DEBUG=true
# [prod: required] Comma-separated hostnames, e.g. menuamano.example.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Production only. Needed when forms are posted from another origin, e.g. https://menuamano.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=
# Production only. Keep the defaults behind Dokploy's HTTPS proxy.
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_HSTS_SECONDS=3600
# Production only. Gunicorn worker processes.
# GUNICORN_WORKERS=3

# --- Database ----------------------------------------------------------------------------------
# compose.yaml / compose.prod.yaml set POSTGRES_HOST=db inside the containers.
POSTGRES_DB=menuamano
POSTGRES_USER=menuamano
# [prod: required] Use a strong password in production.
POSTGRES_PASSWORD=menuamano
# Used when running manage.py or pytest from a local virtualenv against the compose database.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
# Seconds to keep database connections open.
POSTGRES_CONN_MAX_AGE=60

# --- Local ports (compose.yaml only) -------------------------------------------------------------
WEB_HOST_PORT=8010
DB_HOST_PORT=5433

# --- Email ---------------------------------------------------------------------------------------
# "console" prints emails in the web logs (local default); "mailgun" sends them (production default).
EMAIL_PROVIDER=console
# [prod: required] Sender address on the Mailgun domain, e.g. menuamano <no-reply@mg.example.com>
DEFAULT_FROM_EMAIL=menuamano <no-reply@localhost>
# Sender of server error reports. Defaults to DEFAULT_FROM_EMAIL.
SERVER_EMAIL=
# Who receives server error reports, e.g. "Ana <ana@example.com>, ops@example.com"
DJANGO_ADMINS=
# [prod: required] Mailgun sending API key for the domain.
MAILGUN_API_KEY=
# [prod: required] Domain verified in Mailgun, e.g. mg.example.com
MAILGUN_SENDER_DOMAIN=
# US region by default; EU accounts: https://api.eu.mailgun.net/v3
MAILGUN_API_URL=https://api.mailgun.net/v3
# Recommended in production: enables https://<domain>/anymail/mailgun/tracking/ (bounces, complaints).
MAILGUN_WEBHOOK_SIGNING_KEY=
# Optional extra basic auth for webhooks ("user:password"); Mailgun already signs its requests.
ANYMAIL_WEBHOOK_SECRET=
# Seconds to wait for the Mailgun API.
EMAIL_TIMEOUT_SECONDS=15

# --- AI assistant --------------------------------------------------------------------------------
# "demo" (deterministic, no key, clearly labelled) or "openai".
AI_PROVIDER=demo
# Only read by the backend. Required when AI_PROVIDER=openai.
OPENAI_API_KEY=
# Any model that supports Structured Outputs in the Responses API. Required when AI_PROVIDER=openai.
OPENAI_MODEL=
OPENAI_TIMEOUT_SECONDS=45
OPENAI_MAX_RETRIES=2
# Reasoning tokens count against this budget.
OPENAI_MAX_OUTPUT_TOKENS=16000
# none, low, medium, high… Empty = do not send the parameter (models without reasoning).
OPENAI_REASONING_EFFORT=low

# --- Billing (Stripe) ----------------------------------------------------------------------------
# Locally billing is off unless STRIPE_SECRET_KEY is set (everything unlocked).
# In production it is on by default and the four STRIPE_* values below are required.
# [prod: required unless BILLING_ENABLED=false] Secret key (sk_live_… / sk_test_…).
STRIPE_SECRET_KEY=
# [prod: required unless BILLING_ENABLED=false] Signing secret of the webhook endpoint (whsec_…).
STRIPE_WEBHOOK_SECRET=
# [prod: required unless BILLING_ENABLED=false] Price ids of the Premium product.
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
# Let Stripe Tax compute VAT in Checkout (requires Stripe Tax to be set up).
STRIPE_AUTOMATIC_TAX=false
# BILLING_ENABLED=
FREE_MAX_MEMBERS=2
PREMIUM_MAX_MEMBERS=8
PREMIUM_AI_MONTHLY_LIMIT=150
# Display only: Stripe charges the price configured in the price ids above.
PREMIUM_PRICE_MONTHLY_LABEL=4,99 €
PREMIUM_PRICE_YEARLY_LABEL=49 €
# Public URL of the site, used for links in emails sent from webhooks.
SITE_URL=

# --- Analytics (Google Tag Manager) ----------------------------------------------------------------
# Empty locally (not loaded). Production default: GTM-WWR8DTN8.
GTM_CONTAINER_ID=
# "public" (default): only for visitors who are not signed in; "all": every page (titles contain
# names and health data such as weight, so only with a legal basis for it).
GTM_SCOPE=public
# Own consent banner with Consent Mode v2. Set to false if a CMP is configured inside GTM.
COOKIE_CONSENT_BANNER=true
